# Server Environment Variables
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas cloud connection URI)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fleetflow?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fleetflow

# JSON Web Token Secret Key
JWT_SECRET=replace_with_a_secure_random_secret_string

# Environment (development or production)
NODE_ENV=production
